Package: nlmixr2shiny
Type: Package
Title: Shiny Interface for nlmixr2 Modeling and Simulation
Version: 0.1.0
Authors@R: c(
   person("Matthew L.","Fidler", role = c("aut", "cre"), email = "matthew.fidler@gmail.com", comment=c(ORCID="0000-0001-8538-6691")),
   person("Emmanuel Taiwo", "Adewuyi", role="aut", email="olex.taiwo@gmail.com"),
